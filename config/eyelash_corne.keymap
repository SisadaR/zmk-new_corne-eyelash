#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&soft_off { hold-time-ms = <2000>; };

&mt { flavor = "balanced"; };

&lt { flavor = "balanced"; };

/ {
    behaviors {

        mh: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <0>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        td0: td0 {
            compatible = "zmk,behavior-tap-dance";
            display-name = "Shift/Caps Lock Tap Dance";
            #binding-cells = <0>;
            bindings = <&kp LEFT_SHIFT>, <&kp CAPS>;
        };
       

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <5>;
            cw-binding = <&kp C_VOL_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };
    };

     



    keymap {
        compatible = "zmk,keymap";

       
        base0 {
            display-name = "QWERTY";
            bindings = <
&trans  &kp Q         &kp W        &kp E       &kp R       &kp T                            &trans          &kp Y      &kp U       &kp I            &kp O        &kp P            &trans
&trans  &lt 3 A       &mh LCTRL S  &mh LALT D  &mh LGUI F  &lt 6 G              &trans      &trans  &trans  &kp H      &mh RGUI J  &mh RALT K       &mh RCTRL L  &lt 5 SEMICOLON  &trans
&trans  &mt RSHIFT Z  &kp X        &kp C       &kp V       &kp B        &trans              &trans          &kp N      &kp M       &kp COMMA        &kp DOT      &mt RSHIFT FSLH  &trans
                                   &lt 7 ESC   &mo 1       &lt 4 SPACE                                      &kp ENTER  &lt 2 APOS  &lt 7 BACKSPACE
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        //

        raise1 {
            display-name = "RAISE";
            bindings = <
&trans  &kp N1    &kp N2  &kp N3        &kp N4          &kp N5                          &trans          &kp N6    &kp N7         &kp N8         &kp N9            &kp N0    &trans
&trans  &kp LBKT  &trans  &kp PLUS      &kp KP_MINUS    &kp LPAR            &trans      &trans  &trans  &kp RPAR  &kp MINUS      &kp EQUAL      &kp LEFT_BRACKET  &kp RBKT  &trans
&trans  &kp LT    &trans  &kp KP_EQUAL  &kp UNDERSCORE  &kp LBRC    &trans              &trans          &kp RBRC  &kp SQT        &trans         &trans            &kp GT    &trans
                          &trans        &trans          &trans                                          &trans    &kp LC(SPACE)  &kp BACKSLASH
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        lower2 {
            display-name = "LOWER";
            bindings = <
&trans  &kp EXCL   &kp AT     &kp HASH  &kp DLLR       &kp PRCNT                       &trans          &kp CARET  &kp AMPS  &kp KP_MULTIPLY  &kp LPAR  &kp RPAR       &trans
&trans  &kp GRAVE  &kp TILDE  &kp F1    &kp F2         &kp F3              &trans      &trans  &trans  &kp F4     &kp F5    &kp F6           &none     &kp PIPE       &trans
&trans  &trans     &trans     &kp F7    &kp F8         &kp F9      &trans              &trans          &kp F10    &kp F11   &kp F12          &trans    &kp BACKSLASH  &trans
                              &trans    &kp LC(SPACE)  &trans                                          &trans     &trans    &kp PIPE
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        numpad3 {
            display-name = "NUMPAD";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                          &trans          &kp KP_PLUS      &kp KP_N7        &kp KP_N8   &kp KP_N9  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans      &trans  &trans  &kp KP_MINUS     &kp KP_N4        &kp KP_N5   &kp KP_N6  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans              &trans          &kp KP_MULTIPLY  &kp KP_N1        &kp KP_N2   &kp KP_N3  &trans  &trans
                        &trans  &trans  &kp EQUAL                                       &kp KP_SLASH     &kp KP_NUMBER_0  &kp KP_DOT
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        Direction4 {
            display-name = "NAV";
            bindings = <
&none  &kp ESCAPE  &none      &none     &none     &kp INSERT                      &trans          &kp HOME        &kp PAGE_DOWN   &kp PAGE_UP   &kp END          &kp BACKSPACE    &none
&none  &none       &kp LCTRL  &kp LALT  &kp LGUI  &none               &trans      &trans  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &none            &none
&none  &kp LSHIFT  &none      &none     &none     &kp DEL     &trans              &trans          &kp BACKSPACE   &none           &none         &none            &kp RIGHT_SHIFT  &none
                              &none     &none     &kp TAB                                         &kp TAB         &none           &none
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        Number5 {
            display-name = "NUMBERS";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                          &trans          &kp KP_PLUS      &kp N7  &kp N8      &kp N9  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans              &trans      &trans  &trans  &kp KP_MINUS     &kp N4  &kp N5      &kp N6  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans      &trans              &trans          &kp KP_MULTIPLY  &kp N1  &kp N2      &kp N3  &trans  &trans
                        &trans  &trans  &kp EQUAL                                       &kp KP_SLASH     &kp N0  &kp KP_DOT
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        }; 

        Mouse6 {
            display-name = "MOUSE";
            bindings = <
&trans  &kp ESC     &trans     &trans    &trans    &trans                          &trans          &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &none   &trans
&trans  &kp TAB     &kp LCTRL  &kp LALT  &kp LGUI  &trans              &trans      &trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &trans  &trans
&trans  &kp LSHIFT  &trans     &trans    &trans    &kp DEL     &trans              &trans          &kp BACKSPACE   &mkp MB4        &mkp MB5      &trans           &trans  &trans
                               &trans    &trans    &mkp LCLK                                       &mkp RCLK       &mkp MCLK       &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        Config7 {
            display-name = "CONFIG";
            bindings = <
&trans  &trans  &trans        &trans        &trans        &trans                          &trans          &bt BT_CLR    &bt BT_CLR_ALL    &trans          &trans           &kp CAPS    &trans
&trans  &trans  &trans        &trans        &trans        &out OUT_TOG        &trans      &trans  &trans  &trans        &trans            &trans          &trans           &kp KP_NUM  &trans
&trans  &trans  &trans        &trans        &trans        &trans      &trans              &trans          &trans        &bt BT_SEL 0      &bt BT_SEL 1    &bt BT_SEL 2    &trans      &trans
                              &trans        &trans        &trans                                          &out OUT_USB  &out OUT_BLE      &trans  &trans
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
        };
    };
};
